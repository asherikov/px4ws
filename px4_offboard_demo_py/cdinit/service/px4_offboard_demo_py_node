type = process
env-file = $1
command = ros2 run px4_offboard_demo_py demo_node \
    --config-path ${CDINIT_INSTALL_ROOT_PACKAGE_px4_offboard_demo_py}/share/px4_offboard_demo_py/config/default.yaml \
    --ros-args -r __ns:=/${PX4SITL_ROS_NAMESPACE} -p use_sim_time:=true

stop-timeout = 20.0

options = shares-console

depends-on = px4sitl_px4_headless@$1
depends-ms = cdinit_log@px4_offboard_demo_py_node@$1
depends-ms = cdinit_ros2_bag
