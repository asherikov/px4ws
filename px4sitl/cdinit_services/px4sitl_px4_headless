type = process
env-file = $1
command = env \
    PATH=${PATH}:${CDINIT_INSTALL_ROOT_PACKAGE_px4sitl}/px4/bin \
    PX4_GZ_WORLD=${PX4SITL_WORLD_SDF_NAME} \
    PX4_GZ_STANDALONE=YES \
    PX4_UXRCE_DDS_NS=px4_drone_${PX4SITL_PX4_INSTANCE} \
    PX4_PARAM_NAV_DLL_ACT=0 \
    PX4_PARAM_NAV_RCL_ACT=0 \
    PX4_PARAM_COM_RCL_EXCEPT=4 \
    PX4_PARAM_COM_RC_IN_MODE=4 \
    ${CDINIT_INSTALL_ROOT_PACKAGE_px4sitl}/px4/bin/px4 \
        -d \
        -w ${CDINIT_SESSION_ROOT}/px4_${PX4SITL_PX4_INSTANCE} \
        -i ${PX4SITL_PX4_INSTANCE} \
        ${CDINIT_INSTALL_ROOT_PACKAGE_px4sitl}/px4/etc

stop-timeout = 20.0

log-type = pipe

depends-on = px4sitl_gz_wait
depends-ms = cdinit_log@px4sitl_px4_headless@$1

options = always-chain
chain-to = cdinit_shutdown_debug
